{
  "rules": {
    ".read": false,
    ".write": false,

    "teachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'",
        "room": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        "classes": {
          ".indexOn": ["endedAt"],
          "$classId": {
            ".validate": "newData.hasChildren(['name', 'endedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
            "endedAt": { ".validate": "newData.isNumber()" },
            "startedAt": { ".validate": "newData.isNumber()" },
            "pin": { ".validate": "newData.isString()" },
            "students": { ".validate": "newData.isNumber()" },
            "words": { ".validate": "newData.isNumber()" },
            "top": { ".validate": "newData.hasChildren()" },
            "$other": { ".validate": false }
          }
        },
        "classDetails": {
          "$classId": { ".validate": true }
        },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      "$pin": {
        ".read": "auth != null && data.child('hostUid').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && auth.token.firebase.sign_in_provider === 'google.com' && newData.child('hostUid').val() === auth.uid && $pin.matches(/^[0-9]{6}$/)) || data.child('hostUid').val() === auth.uid)",

        "meta": {
          ".read": "auth != null"
        },

        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($pin).child('meta').exists()",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "answers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($pin).child('players').child($uid).exists()",
            ".validate": "newData.hasChildren(['text'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "said": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$wordId": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($pin).child('players').child($uid).exists()",
              ".validate": "newData.hasChildren(['text', 'at'])",
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
              "at": { ".validate": "newData.isNumber()" },
              "via": { ".validate": "newData.val() === 'speak' || newData.val() === 'type' || newData.val() === 'write'" },
              "ink": { ".validate": "newData.isString() && newData.val().length <= 30000" },
              "$other": { ".validate": false }
            }
          }
        },

        "marks": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$wordId": { ".validate": "newData.isBoolean()" }
          }
        },

        "scores": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
